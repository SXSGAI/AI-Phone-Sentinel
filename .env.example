# ===== 对话大模型：Moonshot Kimi K2.5 =====
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=在这里填 Moonshot 的 API Key（platform.moonshot.cn 创建）
LLM_MODEL=kimi-k2.5

# ===== 语音识别 ASR：小米 MiMo（已验证，支持 wav/mp3 直传）=====
ASR_PROVIDER=mimo
ASR_BASE_URL=https://api.xiaomimimo.com/v1
ASR_API_KEY=在这里填小米sk开头的Key
ASR_MODEL=mimo-v2.5-asr
# 备选：whisper=本地离线识别 / none=打字模式
# ASR_PROVIDER=whisper

# ===== 语音合成 TTS：小米 MiMo（已验证），失败自动回退微软 Edge =====
TTS_PROVIDER=mimo
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=茉莉
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ===== 企业微信群机器人 Webhook（必须是 qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx 格式）=====
WECOM_WEBHOOK=
